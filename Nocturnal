    Theme = "Sapphire",
    Transparency = 0
}

local currentSettings = settings

local function saveStuff()
    if writefile then
        pcall(function() writefile(saveFile, http:JSONEncode(currentSettings)) end)
    end
end

local function loadStuff()
    if isfile and readfile and isfile(saveFile) then
        pcall(function()
            local decoded = http:JSONDecode(readfile(saveFile))
            if decoded then
                for k, v in pairs(decoded) do
                    if type(v) == "table" and type(currentSettings[k]) == "table" then
                        for k2, v2 in pairs(v) do currentSettings[k][k2] = v2 end
                    else
                        currentSettings[k] = v
                    end
                end
            end
        end)
    end
end

