local arenaCFrame = CFrame.new(-20.6, 256.0, -595.1, -0.973349154, -4.88010841e-08, -0.229328111, -4.29342961e-08, 1, -3.05720071e-08, 0.229328111, -1.99111962e-08, -0.973349154)
local arenaSize = Vector3.new(31, 15, 15)

local function isPlayerInArena(char)
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    local localPos = arenaCFrame:PointToObjectSpace(root.Position)
    local halfSize = arenaSize / 2
    
    return math.abs(localPos.X) <= halfSize.X 
       and math.abs(localPos.Y) <= halfSize.Y 
       and math.abs(localPos.Z) <= halfSize.Z
end

local targetCFrame = CFrame.new(-9.65371513, 255.272766, -611.338257, -0.797527432, -1.24680053e-08, 0.60328269, -5.25633981e-09, 1, 1.37181635e-08, -0.60328269, 7.769553e-09, -0.797527432)
local targetPosition = targetCFrame.Position 

local pathParams = { AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, AgentJumpHeight = 10, AgentMaxSlope = 45 }
local path = PathfindingService:CreatePath(pathParams)
local isWalking = false

me.CharacterAdded:Connect(function()
    isWalking = false
end)

local function walkToTarget(char, hum, root)
    local function scanSurroundings()
        local rayOrigin = root.Position
        local rayDirection = root.CFrame.LookVector * 3 
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {char}
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        if workspace:Raycast(rayOrigin, rayDirection, raycastParams) then hum.Jump = true end
    end

    while autoFarmData.IsActive and not isPlayerInArena(char) and hum.Health > 0 and (root.Position - targetPosition).Magnitude > 1.5 do
        if getgenv().IsFarmPaused then
            hum:MoveTo(root.Position) 
            while getgenv().IsFarmPaused and autoFarmData.IsActive and hum.Health > 0 do
                task.wait(0.5) 
            end
            if not autoFarmData.IsActive or hum.Health <= 0 then break end 
        end

        local success, _ = pcall(function() path:ComputeAsync(root.Position, targetPosition) end)

        if success and path.Status == Enum.PathStatus.Success then
            local waypoints = path:GetWaypoints()

            for _, waypoint in ipairs(waypoints) do
                if not autoFarmData.IsActive or hum.Health <= 0 then break end
                if isPlayerInArena(char) then break end 
                if getgenv().IsFarmPaused then break end 
                if (root.Position - targetPosition).Magnitude <= 1.5 then break end

                if waypoint.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end

                hum:MoveTo(waypoint.Position)

                local moveConnection
                local reached = false
                local timeOut = tick() + 2 

                moveConnection = hum.MoveToFinished:Connect(function() reached = true end)

                while not reached and tick() < timeOut do
                    if not autoFarmData.IsActive or isPlayerInArena(char) or getgenv().IsFarmPaused or hum.Health <= 0 then break end
                    scanSurroundings()
                    task.wait(0.05)
                end

                moveConnection:Disconnect()

                if not reached and autoFarmData.IsActive and not getgenv().IsFarmPaused and hum.Health > 0 then
                    hum.Jump = true
                    break
                end
            end
        else
            task.wait(1)
        end
    end
    
    if autoFarmData.IsActive and not isPlayerInArena(char) and not getgenv().IsFarmPaused and hum.Health > 0 then
        hum:MoveTo(targetPosition)
        local t = tick() + 2
        while (root.Position - targetPosition).Magnitude > 1 and tick() < t and hum.Health > 0 do
            task.wait(0.1)
        end
        if hum.Health > 0 then
            root.CFrame = targetCFrame
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if not autoFarmData.IsActive then continue end
        
        local char = me.Character
        if not char then continue end
        
        local hum = char:FindFirstChild("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root or hum.Health <= 0 then continue end
        
        local insideArena = isPlayerInArena(char)
        
        if insideArena then
            if autoFarmData.Mode == "Alt" then
                hum.Health = 0 
                char:BreakJoints()
            end
        else
            if not isWalking and not getgenv().IsFarmPaused then
                isWalking = true
                walkToTarget(char, hum, root)
                isWalking = false
            end
        end
    end
end)
